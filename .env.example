# Copier en .env et remplir. Ne JAMAIS committer .env.
# Déploiement (DEPLOIEMENT.md) : cinq lignes à remplir, marquées « À REMPLIR » : HF_TOKEN, LLM_PRINCIPAL_CLE,
# LLM_REPLI_CLE, GESTUKAAY_SEL et POSTGRES_PASSWORD. Le reste a déjà ses valeurs.

# --- Docker Compose ------------------------------------------------------
# « voix » : transcription (M-Kiriku) et voix de réponse (Oolel) sur le GPU NVIDIA. Vide : sans la voix.
COMPOSE_PROFILES=voix
# À REMPLIR : jeton de lecture Hugging Face, après avoir accepté les conditions de
# https://huggingface.co/AIHubSN/M-Kiriku-ASR (téléchargement des modèles de voix)
HF_TOKEN=
# Clé partagée entre l'API et les services de voix (réseau interne de Docker) : à changer
VOIX_CLE=gestukaay-voix-interne

# --- Moteur -------------------------------------------------------------
# fake : réponses d'exemple du contrat (développement web/backend)
# reel : moteur branché sur le socle et le LLM
GESTUKAAY_MOTEUR=reel

# --- LLM : chaîne de fournisseurs, essayés dans l'ordre (issue #9) -----
# Chaque maillon : FOURNISSEUR = gemini | anthropic | huggingface | openai_compatible | regles
#   openai_compatible couvre OpenRouter, OpenAI, Mistral, Groq et Ollama (local).
#   regles = secours local sans réseau (lexique + référentiel), branché par le moteur.
# Changer de fournisseur = changer ces lignes, jamais le code.
# Test réel de la chaîne : uv run python engine/scripts/essai_llm.py
LLM_CHAINE=principal,repli,secours
LLM_DELAI_S=2

# À REMPLIR, OBLIGATOIRE : une clé Gemini (https://aistudio.google.com/apikey), la même dans les DEUX lignes
# LLM_PRINCIPAL_CLE et LLM_REPLI_CLE. Sans réponse de Gemini, le moteur se replie sur des règles locales :
# un secours qui comprend beaucoup moins bien, pas un mode de fonctionnement (DEPLOIEMENT.md, section 3).
LLM_PRINCIPAL_FOURNISSEUR=gemini
LLM_PRINCIPAL_MODELE=gemini-2.5-flash
LLM_PRINCIPAL_RAISONNEMENT=non
LLM_PRINCIPAL_CLE=
# Latence (recette du 08/10, décision 0038) : Flash répond en 1,9 s (médiane), 2,7 s (75 %), 3,6 s (90 %),
# mais 1 fois sur 10 il ne répond pas du tout. Délai 4 s, tenu pour de bon ; au bout de 2 s sans réponse,
# le repli part en parallèle (relais) : Flash reste servi s'il répond avant 4 s, sinon le repli, déjà prêt.
LLM_PRINCIPAL_DELAI_S=4
LLM_PRINCIPAL_RELAIS_S=2

LLM_REPLI_FOURNISSEUR=gemini
LLM_REPLI_MODELE=gemini-2.5-flash-lite
LLM_REPLI_RAISONNEMENT=non
LLM_REPLI_CLE=
# Flash-Lite : 1,3 s (médiane), 2,0 s (75 %), 3,8 s (90 %). Au pire, règles locales à 2 + 3 = 5 s.
LLM_REPLI_DELAI_S=3

# Facultatif, développement : un modèle local Ollama (décommenter et ajouter « local » à LLM_CHAINE)
# LLM_LOCAL_FOURNISSEUR=openai_compatible
# LLM_LOCAL_URL=http://localhost:11434/v1
# LLM_LOCAL_MODELE=qwen3:4b
# LLM_LOCAL_DELAI_S=4

LLM_SECOURS_FOURNISSEUR=regles

# --- Variantes : elles REMPLACENT un bloc ci-dessus (un nom de maillon = un seul bloc).
# Si une variable est définie deux fois, c'est la dernière qui compte (et essai_llm.py le signale).
#
# Variante « tout OpenRouter » :
# LLM_PRINCIPAL_FOURNISSEUR=openai_compatible
# LLM_PRINCIPAL_URL=https://openrouter.ai/api/v1
# LLM_PRINCIPAL_MODELE=google/gemini-2.5-flash
# LLM_PRINCIPAL_CLE=sk-or-...        (OpenRouter donne le coût exact : PRIX inutiles)
# LLM_PRINCIPAL_HEBERGEURS=cerebras,groq   (hébergeurs essayés en premier, dans l'ordre)
# LLM_PRINCIPAL_TRI=latency                (sinon : throughput, price)
# LLM_PRINCIPAL_RAISONNEMENT=non          (désactive la « réflexion » des modèles gpt-oss,
#                                          DeepSeek, Qwen3… : bien plus rapide ; ou low, minimal)
# Gemini direct (LLM_<N>_FOURNISSEUR=gemini) : seul « non » est lu, et seulement pour Gemini 2.5 Flash et
# Flash-Lite (3 à 7 s -> 1,5 s par question). Gemini 2.5 Pro ne peut pas couper sa réflexion : avec « non »,
# il répond en erreur et chaque question passe au relais sans que ça se voie. Ne pas le mettre pour Pro.
# Raccourci sans réglage : suffixe « :nitro » sur le modèle = hébergeur le plus rapide.
# Éviter les modèles « :free » : limites de débit très basses (erreurs 429).
#
# Variante Hugging Face (Inference Providers, jeton sur huggingface.co/settings/tokens) :
# LLM_PRINCIPAL_FOURNISSEUR=huggingface
# LLM_PRINCIPAL_MODELE=deepseek-ai/DeepSeek-V4.1-Flash
# LLM_PRINCIPAL_CLE=hf_...
# LLM_PRINCIPAL_URL=https://<endpoint>.endpoints.huggingface.cloud/v1   (seulement pour un endpoint dédié)
# Options par maillon : LLM_<NOM>_DELAI_S, LLM_<NOM>_RELAIS_S, LLM_<NOM>_TEMPERATURE (« aucune » pour ne pas
# l'envoyer : certains modèles la refusent), LLM_<NOM>_JSON (schema | objet | aucun).

# --- WhatsApp Cloud API (Meta), facultatif : DEPLOIEMENT.md, section 7 -----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Telegram, facultatif : un bot créé avec @BotFather (DEPLOIEMENT.md, section 7) --
TELEGRAM_BOT_TOKEN=
# Jeton secret passé à setWebhook (secret_token) : Telegram le renvoie dans chaque appel
TELEGRAM_SECRET_TOKEN=

# --- Web et adresse publique ------------------------------------------
# En local : laisser tel quel. Adresse publique en HTTPS (Telegram, WhatsApp) : COMPOSE_PROFILES=voix,https,
# puis DOMAINE, GESTUKAAY_URL_PUBLIQUE et NEXT_PUBLIC_API_URL sur ce domaine, et GESTUKAAY_PROXY_DE_CONFIANCE=1
GESTUKAAY_URL_PUBLIQUE=http://localhost:3000
# DOMAINE=gestukaay.exemple.sn
# NEXT_PUBLIC_API_URL=https://gestukaay.exemple.sn

# --- Socle -------------------------------------------------------------
# Socle extrait, téléchargé par ./scripts/recuperer_socle.sh (hors Git, décision 0013) : un dossier de version
# (./socle_gestukaay/2026.10.1) ou le dossier qui les contient (la version publiée la plus récente est prise)
GESTUKAAY_SOCLE_EXTRAIT=./socle_gestukaay
# Développement seulement : les fichiers bruts du portail, pour reconstruire le socle (socle/scripts/extraire.py)
# GESTUKAAY_SOCLE_BRUT=../socle_opendata_par_themes

# --- Base et back-office (backend/stockage.py) -------------------------
# Hors Docker : vide = SQLite en mémoire (perdu au redémarrage),
# ou sqlite:///gestukaay.db pour garder les réponses dans un fichier.
# Dans Docker Compose, la base PostgreSQL est branchée automatiquement.
GESTUKAAY_BASE=
# À REMPLIR : mot de passe de la base PostgreSQL de Docker Compose
POSTGRES_PASSWORD=
# À REMPLIR : sel qui pseudonymise les numéros de téléphone dans le journal (par exemple : openssl rand -hex 16).
# Gardé hors de la base, il empêche de retrouver les numéros à partir d'une copie de la base.
GESTUKAAY_SEL=
# Back-office : un compte par personne, créé en ligne de commande (décision 0037) :
#   docker compose exec api python -m gestukaay_backend.comptes creer <identifiant>
# Benchmark avec le LLM depuis le back-office (Jeu de test) : environ 0,07 $ et 2 à 3 minutes de moteur
# occupé. Désactivé par défaut ; « oui » seulement en local ou hors démo. Le mode règles reste libre.
GESTUKAAY_BENCHMARK_LLM=

# --- Protection de l'API (backend/securite.py) -------------------------
# Limites de requêtes par adresse et par minute ; « off » seulement pour les tests
GESTUKAAY_LIMITES=on
# 1 derrière le proxy de l'hébergeur (préproduction) : l'adresse vient de X-Forwarded-For.
# Jamais sans proxy : l'en-tête serait falsifiable.
GESTUKAAY_PROXY_DE_CONFIANCE=0

# --- Voix (décisions 0026, 0027, 0029) ------------------------------------
# Avec Docker Compose (profil « voix ») : laisser ces quatre lignes vides. L'API joint les services
# transcription et synthese du compose, avec VOIX_CLE. À remplir seulement si la voix tourne sur une autre
# machine (transcription/serveur.py, synthese/serveur.py) : son adresse et le jeton choisi des deux côtés.
TRANSCRIPTION_URL=
TRANSCRIPTION_CLE=
# Facultatif, déconseillé : ADIA, API payante, en repli de la voix ; les enregistrements partent alors chez un
# tiers (page Confidentialité). Vide : une note vocale reçoit une réponse écrite si la voix locale est en panne.
ADIA_API_KEY=

SYNTHESE_URL=
SYNTHESE_CLE=
