# Copier en .env et remplir. Ne JAMAIS committer .env.

# --- Moteur -------------------------------------------------------------
# fake : réponses d'exemple du contrat (développement web/backend)
# reel : moteur branché sur le socle et le LLM
GESTUKAAY_MOTEUR=fake

# --- LLM : chaîne de fournisseurs, essayés dans l'ordre (issue #9) -----
# Chaque maillon : FOURNISSEUR = gemini | anthropic | huggingface | openai_compatible | regles
#   openai_compatible couvre OpenRouter, OpenAI, Mistral, Groq et Ollama (local).
#   regles = secours local sans réseau (lexique + référentiel), branché par le moteur.
# Changer de fournisseur = changer ces lignes, jamais le code.
# Test réel : uv run python engine/scripts/essai_llm.py
# Chaîne mesurée sur les 103 questions du jeu de test (#10, mesure/rapports/comprehension_*.md) :
#   Gemini 2.5 Flash via OpenRouter : 99/103, médiane 1,1 s, ~0,0006 $ par question.
#   Flash-Lite : plus rapide (0,8 s) mais moins juste ; en repli. Qwen3-32B : 3,4 s, trop lent.
LLM_CHAINE=principal,repli,secours
LLM_DELAI_S=2

LLM_PRINCIPAL_FOURNISSEUR=openai_compatible
LLM_PRINCIPAL_URL=https://openrouter.ai/api/v1
LLM_PRINCIPAL_MODELE=google/gemini-2.5-flash
LLM_PRINCIPAL_RAISONNEMENT=non
LLM_PRINCIPAL_CLE=

LLM_REPLI_FOURNISSEUR=openai_compatible
LLM_REPLI_URL=https://openrouter.ai/api/v1
LLM_REPLI_MODELE=google/gemini-2.5-flash-lite
LLM_REPLI_RAISONNEMENT=non
LLM_REPLI_CLE=

# Ollama sur la machine (facultatif : ajouter « local » à LLM_CHAINE pour l'utiliser)
LLM_LOCAL_FOURNISSEUR=openai_compatible
LLM_LOCAL_URL=http://localhost:11434/v1
LLM_LOCAL_MODELE=qwen3:4b
LLM_LOCAL_DELAI_S=4

LLM_SECOURS_FOURNISSEUR=regles

# --- Variantes : elles REMPLACENT un bloc ci-dessus (un nom de maillon = un seul bloc).
# Si une variable est définie deux fois, c'est la dernière qui compte (et essai_llm.py le signale).
#
# Variante « tout OpenRouter » :
# LLM_PRINCIPAL_FOURNISSEUR=openai_compatible
# LLM_PRINCIPAL_URL=https://openrouter.ai/api/v1
# LLM_PRINCIPAL_MODELE=google/gemini-2.5-flash
# LLM_PRINCIPAL_CLE=sk-or-...        (OpenRouter donne le coût exact : PRIX inutiles)
# LLM_PRINCIPAL_HEBERGEURS=cerebras,groq   (hébergeurs essayés en premier, dans l'ordre)
# LLM_PRINCIPAL_TRI=latency                (sinon : throughput, price)
# LLM_PRINCIPAL_RAISONNEMENT=non          (désactive la « réflexion » des modèles gpt-oss,
#                                          DeepSeek, Qwen3… : bien plus rapide ; ou low, minimal)
# Raccourci sans réglage : suffixe « :nitro » sur le modèle = hébergeur le plus rapide.
# Éviter les modèles « :free » : limites de débit très basses (erreurs 429).
#
# Variante Hugging Face (Inference Providers, jeton sur huggingface.co/settings/tokens) :
# LLM_PRINCIPAL_FOURNISSEUR=huggingface
# LLM_PRINCIPAL_MODELE=deepseek-ai/DeepSeek-V4.1-Flash
# LLM_PRINCIPAL_CLE=hf_...
# LLM_PRINCIPAL_URL=https://<endpoint>.endpoints.huggingface.cloud/v1   (seulement pour un endpoint dédié)
# Options par maillon : LLM_<NOM>_DELAI_S, LLM_<NOM>_TEMPERATURE (« aucune » pour ne pas
# l'envoyer : certains modèles la refusent), LLM_<NOM>_JSON (schema | objet | aucun).

# --- WhatsApp Cloud API (Meta) -----------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Telegram (secours) ------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Web ---------------------------------------------------------------
GESTUKAAY_URL_PUBLIQUE=http://localhost:3000

# --- Socle -------------------------------------------------------------
# Dossier du socle brut (hors Git), relatif à la racine du dépôt
GESTUKAAY_SOCLE_BRUT=../socle_opendata_par_themes
