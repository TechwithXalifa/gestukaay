# Copier en .env et remplir. Ne JAMAIS committer .env.

# --- Moteur -------------------------------------------------------------
# fake : réponses d'exemple du contrat (développement web/backend)
# reel : moteur branché sur le socle et le LLM
GESTUKAAY_MOTEUR=fake

# --- LLM (multi-fournisseur, API compatible OpenAI) ---------------------
# Changer de fournisseur = changer ces trois lignes, rien d'autre.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODELE=
# Modèle de repli si le principal échoue ou dépasse le délai
LLM_MODELE_REPLI=
LLM_DELAI_S=2

# --- WhatsApp Cloud API (Meta) -----------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Telegram (secours) ------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Web ---------------------------------------------------------------
GESTUKAAY_URL_PUBLIQUE=http://localhost:3000
