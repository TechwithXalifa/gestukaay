    "RequeteStructuree": {
      "additionalProperties": false,
      "description": "Ce que le LLM a le droit de produire, et rien d'autre.\n\nLe LLM ne reçoit jamais de valeur numérique du socle [EF-04]. Les codes\nd'indicateurs et de zones sont validés contre le socle par le moteur :\nun code inconnu -> rejet [10.4].",
      "properties": {
        "intention": {
          "enum": [
            "valeur",
            "comparaison",
            "classement",
            "hors_perimetre"
          ],
          "type": "string"
        },
        "indicateur": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "examples": [
            "pvswjnd"
          ]
        },
        "zones": {
          "examples": [
            [
              "SN-TH"
            ]
          ],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "periode": {
          "$ref": "#/$defs/Periode"
        },
        "desagregation": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "examples": [
            {
              "sexe": "Féminin"
            }
          ]
        },
        "ordre": {
          "default": "desc",
          "enum": [
            "desc",
            "asc"
          ],
          "type": "string"
        },
        "confiance": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "intention",
        "indicateur",
        "zones",
        "periode",
        "desagregation",
        "ordre",
        "confiance"
      ],
      "title": "RequeteStructuree",
      "type": "object"
    },
    "Resultat": {
      "additionalProperties": false,
      "description": "Une valeur officielle et tout ce qu'il faut pour la citer.",
      "properties": {
