  "additionalProperties": false,
  "description": "Enveloppe HTTP de toutes les routes qui renvoient une réponse.",
  "properties": {
    "version_contrat": {
      "default": "1.3.0",
      "type": "string"
    },
    "reponse": {
      "discriminator": {
